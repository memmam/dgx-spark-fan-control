#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-only
# Stop and disable the watchdog and the performance daemon, then remove
# their unit files and the command. Does not unload the kernel module and
# does not run dkms remove. Do that from the maintenance guide after the
# factory curve is restored.
set -euo pipefail

if [[ "$(id -u)" -ne 0 ]]; then
  echo "scripts/uninstall-userland must run as root" >&2
  exit 1
fi

systemctl disable --now dgx-fan-watchdog.service
systemctl disable --now dgx-fan-control.service
rm -f /etc/systemd/system/dgx-fan-watchdog.service
rm -f /etc/systemd/system/dgx-fan-control.service
rm -f /usr/local/sbin/dgx-fan-control
systemctl daemon-reload
