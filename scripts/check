#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-only
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Tests must not reach systemctl, sysfs, modules, or power actions.
export DGX_FAN_CONTROL_OFFLINE=1
python3 -m unittest discover -s "${root}/tests" -v
bash -n "${root}/scripts/check" "${root}/scripts/build-sign" \
  "${root}/scripts/generate-signing-key" "${root}/scripts/install-userland" \
  "${root}/scripts/uninstall-userland" "${root}/dkms.conf"
python3 -m py_compile "${root}/research/acpi-floor-sweep/acpi-floor-sweep"
