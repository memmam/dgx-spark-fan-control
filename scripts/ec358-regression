#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-only
"""Bounded EC 3.5.8 check for the 0.1.8 delta on top of e57001b.

With no DGX_FAN_SUPERVISED=1 this process exits 2 and does not run a
command or open /sys. It never writes an ACPI Fan cur_state.

    python3 scripts/ec358-regression
    sudo DGX_FAN_SUPERVISED=1 python3 scripts/ec358-regression preflight
    sudo DGX_FAN_SUPERVISED=1 python3 scripts/ec358-regression install
    sudo DGX_FAN_SUPERVISED=1 python3 scripts/ec358-regression floor
    sudo DGX_FAN_SUPERVISED=1 python3 scripts/ec358-regression service

preflight is read-only. It requires a fwupd Embedded Controller version
or a current kernel pin of EC 3.5.8, and stops if those disagree or are
both missing. It does not change the fwupd block. install is the DKMS
0.1.8 build from docs/installation.md section 3A, then one module reload.
It does not start the performance service and does not restart the manual
unit. floor requires the installed command to match this checkout, refuses
acpi-max without writing, then does set-state 6 and automatic.
service starts dgx-fan-control.service, waits for the idle state-1 pin,
then stops it and requires state 0 again.

Stop on the first failure. No GPU load.
"""

from __future__ import annotations

import os
import re
import subprocess
import sys
import time
from pathlib import Path

OPT_IN = "DGX_FAN_SUPERVISED"
PACKAGE = "dgx-spark-fan-control"
VERSION = "0.1.8"
CHECKOUT = Path(__file__).resolve().parents[1]
CLI_NAME = "dgx-fan-control"
DAEMON_UNIT = "dgx-fan-control.service"
INSTALLED_CLI = Path("/usr/local/sbin") / CLI_NAME
SOURCE_CLI = CHECKOUT / "userspace" / "dgx_fan_control.py"


class Stop(Exception):
    def __init__(self, reason: str) -> None:
        super().__init__(reason)
        self.reason = reason


def run_command(argv: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(argv, check=False, capture_output=True, text=True)


def read_file(path: Path) -> str:
    return path.read_text(encoding="utf-8", errors="replace")


def _ec_profile():
    parent = str(Path(__file__).resolve().parent)
    if parent not in sys.path:
        sys.path.insert(0, parent)
    import ec_profile
    return ec_profile


def confirm_ec(runner, expect: str = "3.5.8") -> None:
    """Read-only. Missing and disagreeing profiles both stop."""
    fw = runner(["fwupdmgr", "get-devices", "--json"])
    fw_text = (fw.stdout or "") if fw.returncode == 0 else ""
    kern = runner(["dmesg"])
    kern_text = (kern.stdout or "") if kern.returncode == 0 else ""
    profile = _ec_profile()
    esrt_text = profile.esrt_versions()
    verdict = profile.classify(fw_text, kern_text, expect, esrt_text)
    if verdict != "OK":
        raise Stop(profile.explain(fw_text, kern_text, esrt_text, expect))


def parse_status(text: str) -> None:
    if "unsupported" in text or "EC 3.13.7" in text:
        raise Stop("status is not an EC 3.5.8 cooling device")
    if "state=0/12 (daemon not setting a floor; EC's own curve)" not in text:
        raise Stop("status is not state 0 on the EC curve")
    if "manual-floor: none" not in text:
        raise Stop("a manual floor is recorded; not changing it")
    if "watchdog-active: active" not in text:
        raise Stop("watchdog is not active")


def performance_inactive(text: str) -> None:
    if text.strip() != "inactive":
        raise Stop(f"performance service is {text.strip()!r}; not stopping it")


def fan_levels(listing: list[tuple[str, str]]) -> list[tuple[str, str]]:
    """(path, level) for type Fan only. The module device is not included."""
    return [(path, level) for path, level in listing if path.endswith("/Fan")]


def dkms_versions(status: str) -> list[str]:
    found = []
    for line in status.splitlines():
        if not line.startswith(PACKAGE + "/"):
            continue
        found.append(line.split("/", 1)[1].split(",", 1)[0].strip())
    return found


def install_commands(kernel: str, old_versions: list[str]) -> list[list[str]]:
    source = f"/usr/src/{PACKAGE}-{VERSION}"
    commands = [
        ["sudo", "install", "-D", "-m", "0755", str(SOURCE_CLI), str(INSTALLED_CLI)],
    ]
    for version in old_versions:
        if version != VERSION:
            commands.append(
                ["sudo", "dkms", "remove", "-m", PACKAGE, "-v", version, "--all"]
            )
    commands.extend([
        ["sudo", "install", "-d", f"{source}/kernel"],
        ["sudo", "install", "-m", "0644", str(CHECKOUT / "dkms.conf"), f"{source}/dkms.conf"],
        ["sudo", "install", "-m", "0644", str(CHECKOUT / "kernel" / "Makefile"),
         str(CHECKOUT / "kernel" / "dgx_ec_fan_control.c"), f"{source}/kernel/"],
        ["sudo", "dkms", "add", "-m", PACKAGE, "-v", VERSION],
        ["sudo", "dkms", "build", "-m", PACKAGE, "-v", VERSION, "-k", kernel],
        ["sudo", "dkms", "install", "-m", PACKAGE, "-v", VERSION, "-k", kernel],
    ])
    return commands


def reload_commands(loaded: bool) -> list[list[str]]:
    commands = []
    if loaded:
        commands.append(["sudo", "modprobe", "-r", "dgx_ec_fan_control"])
    commands.append(["sudo", "modprobe", "dgx_ec_fan_control"])
    return commands


def _text(result: subprocess.CompletedProcess[str]) -> str:
    return (result.stdout or "") + (result.stderr or "")


def _ok(result: subprocess.CompletedProcess[str], what: str) -> str:
    if result.returncode != 0:
        raise Stop(f"{what} failed ({result.returncode}): {_text(result).strip()}")
    return result.stdout or ""


def preflight(runner, reader) -> str:
    confirm_ec(runner)
    # is-active exits 3 when the unit is inactive. The text is the check.
    performance = runner(["systemctl", "is-active", DAEMON_UNIT])
    performance_inactive(performance.stdout or "")
    status = _ok(runner([CLI_NAME, "status"]), "status")
    parse_status(status)
    return status


def assert_same_fans(before: list[tuple[str, str]], after: list[tuple[str, str]]) -> None:
    if before != after:
        raise Stop(f"ACPI Fan cur_state changed from {before} to {after}")


def hottest_c(status: str) -> float:
    match = re.search(r"hottest=([0-9]+(?:\.[0-9]+)?)C", status)
    if match is None:
        raise Stop("status has no hottest zone; not starting the daemon")
    return float(match.group(1))


def daemon_state_line(status: str) -> str:
    for line in status.splitlines():
        if line.startswith("state="):
            return line
    raise Stop("status has no state line")


def service_check(runner, reader, fans, sleep) -> None:
    """Start the performance unit, require the idle state-1 pin, then stop.

    The first status can still be state 0. State 1 is the pin below 50 °C.
    Anything else stops the unit and fails. ACPI Fan levels are only read.
    """
    status = preflight(runner, reader)
    if hottest_c(status) >= 50.0:
        raise Stop("hottest zone is at or above 50 C; idle state-1 check does not apply")
    version = _ok(runner(
        ["modinfo", "-F", "version", "dgx_ec_fan_control"]), "modinfo").strip()
    if version != VERSION:
        raise Stop(f"loaded module is {version!r}, not {VERSION}")
    if reader(INSTALLED_CLI) != reader(SOURCE_CLI):
        raise Stop("installed command does not match this checkout; not starting it")
    before = fan_levels(fans())
    started = False
    try:
        _ok(runner(["sudo", "systemctl", "start", DAEMON_UNIT]), "systemctl start")
        started = True
        last = ""
        for _ in range(8):
            sleep(2)
            last = _ok(runner([CLI_NAME, "status"]), "status during service")
            line = daemon_state_line(last)
            if line.startswith("state=1/12"):
                break
            if line.startswith("state=0/12"):
                continue
            raise Stop(f"daemon left the idle pin: {line}")
        else:
            raise Stop("daemon did not reach state 1 within 16s; stopping the service")
        active = runner(["systemctl", "is-active", DAEMON_UNIT])
        if (active.stdout or "").strip() != "active":
            raise Stop(f"service is {(active.stdout or '').strip()!r} after state 1")
        assert_same_fans(before, fan_levels(fans()))
    finally:
        if started:
            stopped = runner(["sudo", "systemctl", "stop", DAEMON_UNIT])
            if stopped.returncode != 0:
                raise Stop(
                    "systemctl stop failed "
                    f"({stopped.returncode}): {_text(stopped).strip()}"
                )
    for _ in range(8):
        sleep(1)
        status = _ok(runner([CLI_NAME, "status"]), "status after stop")
        active = runner(["systemctl", "is-active", DAEMON_UNIT])
        if ((active.stdout or "").strip() == "inactive" and
                "state=0/12 (daemon not setting a floor; EC's own curve)" in status and
                "manual-floor: none" in status):
            assert_same_fans(before, fan_levels(fans()))
            return
    raise Stop("service stop did not restore state 0 with the unit inactive")


def floor_check(runner, reader, fans) -> None:
    preflight(runner, reader)
    version = _ok(runner(
        ["modinfo", "-F", "version", "dgx_ec_fan_control"]), "modinfo").strip()
    if version != VERSION:
        raise Stop(f"loaded module is {version!r}, not {VERSION}")
    if reader(INSTALLED_CLI) != reader(SOURCE_CLI):
        raise Stop("installed command does not match this checkout; not calling it")
    before = fan_levels(fans())
    refused = runner([CLI_NAME, "acpi-max"])
    if refused.returncode == 0:
        raise Stop("acpi-max succeeded; that write is not part of this tree")
    assert_same_fans(before, fan_levels(fans()))
    _ok(runner(["sudo", CLI_NAME, "set-state", "6"]), "set-state 6")
    status = _ok(runner([CLI_NAME, "status"]), "status after set-state")
    if "state=6/12" not in status:
        raise Stop("set-state 6 did not read back state 6; stopping")
    assert_same_fans(before, fan_levels(fans()))
    _ok(runner(["sudo", CLI_NAME, "automatic"]), "automatic")
    status = _ok(runner([CLI_NAME, "status"]), "status after automatic")
    parse_status(status)
    assert_same_fans(before, fan_levels(fans()))


def install(runner, reader) -> None:
    preflight(runner, reader)
    kernel = _ok(runner(["uname", "-r"]), "uname").strip()
    if not kernel:
        raise Stop("uname -r was empty")
    status = _ok(runner(["dkms", "status", "-m", PACKAGE]), "dkms status")
    for command in install_commands(kernel, dkms_versions(status)):
        _ok(runner(command), " ".join(command))
    listed = runner(["lsmod"])
    if listed.returncode != 0:
        raise Stop(f"lsmod failed ({listed.returncode})")
    loaded = listed.stdout or ""
    for command in reload_commands("\ndgx_ec_fan_control " in "\n" + loaded):
        _ok(runner(command), " ".join(command))
    version = _ok(runner(
        ["modinfo", "-F", "version", "dgx_ec_fan_control"]), "modinfo").strip()
    if version != VERSION:
        raise Stop(f"reload left version {version!r}")
    preflight(runner, reader)


def main(argv: list[str] | None = None, env: dict | None = None,
         runner=None, reader=None, fans=None, sleep=None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    environment = os.environ if env is None else env
    if environment.get(OPT_IN) != "1":
        print(
            "ec358-regression: not touching services, sysfs, or the module. "
            f"Set {OPT_IN}=1 and pass preflight, install, floor, or service.",
            file=sys.stderr,
        )
        return 2
    if runner is None:
        runner = run_command
    if reader is None:
        reader = lambda path: read_file(Path(path))
    if fans is None:
        fans = live_fans
    if sleep is None:
        sleep = time.sleep
    case = args[0] if args else ""
    try:
        if case == "preflight":
            preflight(runner, reader)
        elif case == "install":
            install(runner, reader)
        elif case == "floor":
            floor_check(runner, reader, fans)
        elif case == "service":
            service_check(runner, reader, fans, sleep)
        else:
            raise Stop("choose preflight, install, floor, or service")
    except Stop as stopped:
        print(f"STOP {stopped.reason}", file=sys.stderr)
        return 1
    print(f"PASS {case}")
    return 0


def live_fans() -> list[tuple[str, str]]:
    root = Path("/sys/class/thermal")
    found = []
    for device in sorted(root.glob("cooling_device*")):
        try:
            kind = (device / "type").read_text(encoding="ascii").strip()
            level = (device / "cur_state").read_text(encoding="ascii").strip()
        except OSError:
            continue
        if kind == "Fan":
            found.append((str(device) + "/Fan", level))
    return found


if __name__ == "__main__":
    sys.exit(main())
