[Unit]
Description=DGX Spark additive fan-floor controller
After=systemd-modules-load.service
Wants=systemd-modules-load.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/sbin/dgx-fan-control daemon
# Restart after every exit except 69 and 78. Exit 69 is only the daemon's
# startup check that fan control is unsupported. Exit 78 is a foreign lower
# floor: retrying cannot clear it, and a reboot clears the ACPI floor.
# A transport failure or crash uses another status and is restarted.
# Preventing every 69 used to leave a live daemon dead for 1 d 19 h
# (tenhkspark, 2026-10-31); that failure was not this startup check.
# StartLimitIntervalSec=0 means crash retries continue.
Restart=always
RestartSec=30s
RestartPreventExitStatus=69 78
TimeoutStopSec=30s
CapabilityBoundingSet=
LockPersonality=yes
NoNewPrivileges=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
# ProtectKernelLogs is unset so the daemon can read the probe line and tell
# a foreign floor from any other missing cooling device.
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
