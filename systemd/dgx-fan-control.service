[Unit]
Description=DGX Spark additive fan-floor controller
After=systemd-modules-load.service
Wants=systemd-modules-load.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/sbin/dgx-fan-control daemon
# Restart after every exit except 69. Exit 69 is only the daemon's startup
# check that fan control is unsupported. A transport failure or crash uses
# another status and is restarted. Preventing every 69 used to leave a live
# daemon dead for 1 d 19 h (tenhkspark, 2026-10-31); that failure was not
# this startup check. StartLimitIntervalSec=0 means crash retries continue.
Restart=always
RestartSec=30s
RestartPreventExitStatus=69
TimeoutStopSec=30s
CapabilityBoundingSet=
LockPersonality=yes
NoNewPrivileges=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
